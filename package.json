{
  "name": "@constal/horizon",
  "version": "0.6.27",
  "description": "Constal's long-horizon software agent.",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "deploy": "node scripts/deploy.mjs",
    "deploy:components": "node scripts/deploy-components.mjs",
    "sandbox:check": "node scripts/release-sandbox-image.mjs",
    "sandbox:build": "node scripts/release-sandbox-image.mjs --build constal-horizon-sandbox:dev"
  },
  "dependencies": {
    "@constal-ai/github": "2.0.5",
    "@constal/sdk": "2.5.0"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}

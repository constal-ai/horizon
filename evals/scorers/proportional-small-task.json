{
  "id": "horizon-proportional-small-task",
  "version": "1",
  "displayName": "Horizon proportional small task",
  "description": "Requires a bounded single-file mission to complete with a verified artifact without expanding into unnecessary work units or specialist Runs.",
  "applies": "case",
  "kind": "code",
  "code": {
    "ir": {
      "v": 1,
      "rule": {
        "op": "all",
        "rules": [
          { "op": "equals", "path": "/output/object", "value": "constal.horizon.result" },
          { "op": "equals", "path": "/output/status", "value": "complete" },
          {
            "op": "schema",
            "path": "/output/completedSteps",
            "schema": { "type": "array", "minItems": 1, "maxItems": 2 }
          },
          { "op": "range", "path": "/output/longHorizon/specialistRuns", "min": 10, "max": 20 },
          { "op": "range", "path": "/output/longHorizon/replans", "min": 0, "max": 1 },
          { "op": "equals", "path": "/output/remainingUnknowns", "value": [] }
        ]
      }
    }
  }
}
